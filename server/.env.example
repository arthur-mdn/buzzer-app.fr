# Local dev (node server.js): mongodb://127.0.0.1:27017/buzzer
# Docker Compose overrides this with mongodb://buzzer-mongodb:27017/buzzer
DB_URI=mongodb://127.0.0.1:27017/buzzer
PORT=3001
# Local Vite origin. Production must use https://buzzer-app.fr (CORS).
CLIENT_URL=http://localhost:5174
# Required. Generate a unique secret (32+ chars). Changing it invalidates all JWTs.
# Do not use the documentation placeholder strings; the server rejects known examples.
JWT_SECRET=
# Optional. Leave empty to disable admin registration. Never commit a real value.
ADMIN_PASSWORD=
LISTEN_FOR_PINGS=false
