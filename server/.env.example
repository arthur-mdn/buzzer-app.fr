# Local dev (node server.js): mongodb://127.0.0.1:27017/buzzer
# Docker Compose overrides this with mongodb://buzzer-mongodb:27017/buzzer
DB_URI=mongodb://127.0.0.1:27017/buzzer
PORT=3001
CLIENT_URL=http://localhost:5174
# Required. Changing this value invalidates all existing JWTs (users must re-authenticate).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Optional. When set to a non-empty value, registering with this password grants admin role.
ADMIN_PASSWORD=SET_A_PASSWORD_FOR_THE_USER_TO_GET_ADMIN_PRIVILEGES_PLEASE_CHANGE_IT
LISTEN_FOR_PINGS=false
