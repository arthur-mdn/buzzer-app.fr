# Local Vite dev server listens on 5174 (see npm run dev / vite.config.js).
# VITE_PORT is only used by some Docker build args and is not the browser URL.
VITE_PORT=5174
VITE_INSTANCE_URL=http://localhost:5174
VITE_SERVER_URL=http://localhost:3001
VITE_SERVER_SOCKET_URL=http://localhost:3001
VITE_SEND_PINGS=false

# Production values are passed as Docker build args in docker-compose.prod.yml
